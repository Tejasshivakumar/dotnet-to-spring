# Copy to docker/.env (git-ignored) and uncomment ONE block.
# docker compose reads it automatically.

# --- Google Gemini, free tier. Key: https://aistudio.google.com/apikey
# PORTWAY_AI_ENABLED=true
# PORTWAY_AI_PROVIDER=gemini
# PORTWAY_AI_MODEL=gemini-2.5-flash
# PORTWAY_AI_API_KEY=your-gemini-key

# --- Groq, free tier. Key: https://console.groq.com/keys
# PORTWAY_AI_ENABLED=true
# PORTWAY_AI_PROVIDER=groq
# PORTWAY_AI_MODEL=openai/gpt-oss-20b
# PORTWAY_AI_API_KEY=your-groq-key

# --- OpenRouter, free models (names end in :free). Key: https://openrouter.ai/keys
# PORTWAY_AI_ENABLED=true
# PORTWAY_AI_PROVIDER=openrouter
# PORTWAY_AI_MODEL=qwen/qwen3-coder:free
# PORTWAY_AI_API_KEY=your-openrouter-key

# --- Ollama, local, no key. Start with: --profile ollama (7b is the smallest that handles the sample; ~4.7 GB)
# PORTWAY_AI_ENABLED=true
# PORTWAY_AI_PROVIDER=ollama
# PORTWAY_AI_MODEL=qwen2.5-coder:7b
# PORTWAY_AI_BASE_URL=http://ollama:11434/v1

# --- Anthropic (paid)
# PORTWAY_AI_ENABLED=true
# PORTWAY_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key

# Real Maven verification in an isolated container (needs the Docker socket,
# which this compose file does not mount); in-process is the default.
# PORTWAY_VERIFY_MODE=in-process
